<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>vn.ptit</groupId>
    <artifactId>lap-trinh-mang</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.sun.xml.ws</groupId>
            <artifactId>jaxws-rt</artifactId>
            <version>4.0.2</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <excludes>
                        <exclude>BT/**</exclude>
                        <exclude>learn/**</exclude>
                        <exclude>target/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>4.0.2</version>
                <executions>
                    <execution>
                        <id>data-service</id>
                        <goals><goal>wsimport</goal></goals>
                        <configuration>
                            <packageName>WS.data</packageName>
                            <wsdlUrls>
                                <wsdlUrl>http://36.50.135.242:2221/DataService?wsdl</wsdlUrl>
                            </wsdlUrls>
                        </configuration>
                    </execution>
                    <execution>
                        <id>character-service</id>
                        <goals><goal>wsimport</goal></goals>
                        <configuration>
                            <packageName>WS.character</packageName>
                            <wsdlUrls>
                                <wsdlUrl>http://36.50.135.242:2221/CharacterService?wsdl</wsdlUrl>
                            </wsdlUrls>
                        </configuration>
                    </execution>
                    <execution>
                        <id>object-service</id>
                        <goals><goal>wsimport</goal></goals>
                        <configuration>
                            <packageName>WS.object</packageName>
                            <wsdlUrls>
                                <wsdlUrl>http://36.50.135.242:2221/ObjectService?wsdl</wsdlUrl>
                            </wsdlUrls>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
        </plugins>
    </build>
</project>
